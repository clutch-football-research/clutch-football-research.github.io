  "framework": {
    "primary_metric": {
      "name": "CDCR",
      "definition": "Observed conversion rate on the team's last realistic meaningful offensive opportunity when one possession can tie the game or take the lead in the fourth quarter or overtime.",
      "formula": "CONVERSION / (CONVERSION + FAILURE)",
      "unit": "at most one locked viable CDCR opportunity per team-game"
    },
    "selection_rule": {
      "literal_final_first": true,
      "backward_search_trigger": "Only a qualifying literal-final possession that fails the locked pre-drive viability gate may be skipped backward.",
      "nonqualifying_later_possession_blocks_earlier": true,
      "viability_threshold_pct": 5.0,
      "td_threat_zone_yardline_100": 30,
      "fg_threat_zone_yardline_100": 38,
      "start_already_in_threat_override": true,
      "model_version": "drive-reachability-0.2",
      "threshold_selection_basis": "predeclared threshold sensitivity, low-tail calibration, population stability, and internal blinded pre-drive football-state review",
      "independent_second_review_completed": false,
      "validation_limitation": "No independent reviewer was available; limitation disclosed."
    },
    "difficulty_model": {
      "name": "xCDCR",
      "role": "supplemental",
      "definition": "Cross-fitted expected probability that the selected viable CDCR opportunity converts from its start-of-drive situation.",
      "features": [
        "era",
        "starting score state",
        "time remaining",
        "starting field position"
      ]
    },
    "above_expected": {
      "name": "CAE",
      "role": "supplemental",
      "definition": "CDCR minus xCDCR, expressed in percentage points.",
      "uncertainty_rule": "Confidence intervals must accompany player-level interpretation; an interval crossing zero is not evidence of above-expected performance."
    },
    "companion_event": {
      "name": "Clutch Response Event",
      "role": "descriptive companion; not a replacement rate",
      "definition": "Any qualifying fourth-quarter/overtime possession that reaches the required score state and is classified as a conversion, including earlier successful qualifying possessions.",
      "reporting_rule": "Report event counts and case histories, not a response-event success percentage with an outcome-selected denominator."
    }
  },
