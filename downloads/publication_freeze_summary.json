  "framework": {
    "primary_metric": {
      "name": "CDCR",
      "definition": "Observed conversion rate on the team's last realistic meaningful offensive opportunity when one possession can tie the game or take the lead in the fourth quarter or overtime.",
      "formula": "CONVERSION / (CONVERSION + FAILURE)",
      "unit": "at most one locked viable CDCR opportunity per team-game"
    },
    "selection_rule": {
      "literal_final_first": true,
      "backward_search_trigger": "Only a qualifying literal-final possession that fails the locked pre-drive viability gate may be skipped backward.",
