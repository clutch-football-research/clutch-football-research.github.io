      "independent_second_review_completed": false,
      "validation_limitation": "No independent reviewer was available; limitation disclosed."
    },
    "difficulty_model": {
      "name": "xCDCR",
      "role": "supplemental",
      "definition": "Cross-fitted expected probability that the selected viable CDCR opportunity converts from its start-of-drive situation.",
      "features": [
        "era",
        "starting score state",
        "time remaining",
        "starting field position"
      ]
    },
    "above_expected": {
      "name": "CAE",
      "role": "supplemental",
      "definition": "CDCR minus xCDCR, expressed in percentage points.",
      "uncertainty_rule": "Confidence intervals must accompany player-level interpretation; an interval crossing zero is not evidence of above-expected performance."
    },
    "companion_event": {
      "name": "Clutch Response Event",
      "role": "descriptive companion; not a replacement rate",
      "definition": "Any qualifying fourth-quarter/overtime possession that reaches the required score state and is classified as a conversion, including earlier successful qualifying possessions.",
      "reporting_rule": "Report event counts and case histories, not a response-event success percentage with an outcome-selected denominator."
    }
